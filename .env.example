# Churn Prediction System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key — set a strong random value in production
SECRET_KEY=dev-secret-change-me

# Database path — leave blank to use the default instance/churn_system.db
DATABASE_URL=

# AI confidence threshold — queries below this score are escalated to an agent
CONFIDENCE_THRESHOLD=0.75

# HuggingFace zero-shot classification model
HUGGINGFACE_MODEL=typeform/distilbert-base-uncased-mnli

# Application environment: development | production
APP_ENV=development

# Set to true to warm up the NLP model on Flask startup (increases boot time)
WARMUP_NLP_ON_STARTUP=false

# Comma-separated list of allowed CORS origins (production: set to your frontend domain)
ALLOWED_ORIGINS=http://localhost:5173
